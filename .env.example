# --- Runtime ---
ENV=dev
LOG_LEVEL=INFO
APP_NAME=nova-nutrition-backend
APP_VERSION=0.1.0

# --- Database (asyncpg) ---
# REQUIRED — no fallback default. Owner MUST set this in every environment
# (.env locally, Dokploy panel in staging/prod). Boot fails loud if missing.
# Driver MUST be `postgresql+asyncpg://` — other drivers rejected at boot.
DATABASE_URL=postgresql+asyncpg://nova:novapass@db:5432/nova
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_RECYCLE_SECONDS=3600

# --- Redis ---
# REQUIRED — no fallback default. Owner MUST set this in every environment.
# Boot fails loud if missing or wrong scheme (must be redis:// or rediss://).
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_PRIVATE_KEY_PATH=/secrets/jwt.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt.pub
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=nova-nutrition
JWT_AUDIENCE=nova-mobile

# --- OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=

# --- OpenAI ---
OPENAI_API_KEY=
# Vision model for food photo analysis. Changed 2026-07-11 to gpt-5-mini (gen 2026 with vision).
# Single-model mode: set only OPENAI_VISION_MODEL. Cascade mode: also set PRIMARY + FALLBACK below.
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=1536

# --- Vision cascade (hybrid cost pipeline) ---
# PRIMARY: quality model (gpt-5-mini). FALLBACK: fast stable model (gpt-4o-mini).
# On UpstreamError/timeout in primary, code auto-retries with fallback model.
# Both empty = single-model mode (uses OPENAI_VISION_MODEL for all calls).
OPENAI_VISION_MODEL_PRIMARY=gpt-5-mini
OPENAI_VISION_MODEL_FALLBACK=gpt-4o-mini
VISION_CASCADE_ENABLED=true
VISION_CONFIDENCE_THRESHOLD=0.7
# 4000 tok = headroom for gpt-5-mini (reasoning shares this budget). Do not lower below 3500.
VISION_MAX_OUTPUT_TOKENS=4000
# low is the safe floor for gpt-5-mini on the food decomposition prompt (minimal/medium = empty output)
VISION_REASONING_EFFORT=low
VISION_VERBOSITY=low
VISION_FOOD_PREFILTER_ENABLED=true

# --- Two-pass vision pipeline ---
VISION_TWO_PASS_ENABLED=true
# Max output tokens for Call-1 (identification only — no amounts).
VISION_IDENTIFY_MAX_OUTPUT_TOKENS=1400
# Timeout (ms) to fetch catalog portion hints before Call-2; on timeout Call-2 proceeds without hints.
VISION_PORTION_HINTS_TIMEOUT_MS=500
# Self-consistency K for Call-2. 1=disabled (single call). 3=enabled (K concurrent calls, median per item).
VISION_SELF_CONSISTENCY_K=3

# --- Cost cap (ADR-0004) ---
COST_CAP_USD_PER_USER_PER_DAY=1.50
COST_CAP_USD_PER_ORG_PER_DAY=500.00
COST_CAP_ALARM_PCT=0.80

# --- Rate limits (Redis sliding window) ---
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=5
RATE_LIMIT_API_PER_MIN=60

# --- Arq worker ---
ARQ_MAX_JOBS=2
ARQ_JOB_TIMEOUT_SECONDS=180
ARQ_KEEP_RESULT_SECONDS=3600
ARQ_MAX_QUEUE_DEPTH=100

# --- Web concurrency ---
WEB_CONCURRENCY=2
WEB_MAX_CONCURRENT_REQUESTS=200

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nova-nutrition-backend

# --- i18n ---
SUPPORTED_LOCALES=en,es,pt,fr,de
DEFAULT_LOCALE=en

# --- Regions ---
DEFAULT_REGION=us

# --- Email (Resend — https://resend.com/) ---
# Master kill-switch (false=no emails sent, logged only). Default false
# until owner verifies DNS + sets RESEND_API_KEY.
EMAIL_ENABLED=false
RESEND_API_KEY=

# --- CORS ---
# Comma-separated origins. Empty (default in Settings) = deny-all.
# Owner MUST set explicitly per env.
CORS_ALLOWED_ORIGINS=https://app.ms-tech-stack.cloud,https://ms-tech-stack.cloud

# --- Database container bootstrap (used by `db` service in compose) ---
# These MUST match the credentials encoded in DATABASE_URL above.
POSTGRES_USER=nova
POSTGRES_DB=nova
DB_PASSWORD=novapass

# --- Billing (Stripe + Mercado Pago) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# REQUIRED — Stripe redirect URLs post-checkout / on-cancel. Must be https://.
# Can be web URLs or mobile deep links (e.g. nova://billing/success).
BILLING_SUCCESS_URL=https://app.ms-tech-stack.cloud/billing/success
BILLING_CANCEL_URL=https://app.ms-tech-stack.cloud/billing/cancel

# --- Image fetching scripts (scripts/fetch_images_db.py, scripts/export_catalog_db.py) ---
# Pexels free tier: 25k req/month — https://www.pexels.com/api/
PEXELS_API_KEY=
# Unsplash free tier: 50 req/hour — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# SSH tunnel to prod DB (used by admin scripts only, never by the API)
DB_SSH_HOST=root@<vps-ip>
DB_SSH_PASS=
DB_CONTAINER=
