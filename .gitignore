# Git history rewrite backup folders (created by git-filter-repo)
.git.backup-*

# Claude Code worktree shadow copies (Sprint internal, not for git)
.claude/

# Local ETL state + intermediate outputs (regenerable, not for git)
.cache/
data/meals/recipe_pexels_mapping.json
scripts/sql/

# ── AI assistant config + session notes — LOCAL ONLY (2026-07-09) ─────────────
# Prod (git→CI→VPS) does NOT run these. Keeping them out of the repo avoids
# leaking internal ops, strategy, and AI setup to anyone with repo access.
/CLAUDE.md

# ── Internal docs — SENSITIVE (strategy, moat, competitive, QA, security) ─────
# Contain competitive strategy, VPS details, security posture. NEVER to git.
docs/product/
docs/qa/
docs/handoff/
docs/security/
docs/team/

# ── Moat data — recipe catalog. Prod reads from the DB, not these files. ──────
data/nova_catalog_v1.json

# One-off scripts (backfills/gen/import/fix) — run once, never committed or deployed
scripts/oneoff/

# Sprint reports, accuracy benchmarks, competitive analysis — internal only
