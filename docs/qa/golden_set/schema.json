{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-nutrition.com/schemas/golden_set_entry.json",
  "title": "NOVA Vision Golden Set Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "image_path", "ground_truth", "tolerance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}_(breakfast|lunch|dinner|snack)_[a-z0-9_]+_[0-9]{3}$",
      "description": "Stable slug. Pattern: <region>_<meal>_<dish>_<seq>"
    },
    "image_path": {
      "type": "string",
      "pattern": "^images/.+\\.(jpg|jpeg|png|webp)$"
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kcal",
        "protein_g",
        "carbs_g",
        "fat_g",
        "ingredients",
        "region",
        "meal_time"
      ],
      "properties": {
        "kcal": { "type": "integer", "minimum": 20, "maximum": 3000 },
        "protein_g": { "type": "number", "minimum": 0, "maximum": 250 },
        "carbs_g": { "type": "number", "minimum": 0, "maximum": 400 },
        "fat_g": { "type": "number", "minimum": 0, "maximum": 200 },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "portion_g"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-záéíóúñ ]+$",
                "minLength": 2,
                "maxLength": 60
              },
              "portion_g": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
            }
          }
        },
        "region": {
          "type": "string",
          "enum": ["pe", "mx", "ar", "co", "cl", "br"]
        },
        "meal_time": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"]
        }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kcal_pct", "macro_pct"],
      "properties": {
        "kcal_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "macro_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 500
    }
  }
}
